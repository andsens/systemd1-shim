# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /out/systemd1-shim .

# Bundles its own dbus-daemon so this runs standalone - no separate dbus
# sidecar container needed. Uses the stock system.conf as-is (its <listen>
# is what dbus.ConnectSystemBus() already defaults to, no env var bridging
# needed) plus dbus-policy.conf, a small system.d drop-in granting
# systemd1-shim the bus ownership stock system.conf's default policy would
# otherwise deny. /run/dbus is created explicitly since nothing does that
# automatically outside real systemd's socket activation. Mount an emptyDir
# over /run/dbus (in this container and any siblings that need the same
# bus, e.g. deployment.yaml) to share the socket instead of keeping it
# private to this container.
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends dbus \
	&& rm -rf /var/lib/apt/lists/* \
	&& mkdir -p /run/dbus
COPY --from=build /out/systemd1-shim /systemd1-shim
COPY dbus-policy.conf /etc/dbus-1/system.d/systemd1-shim.conf
ENTRYPOINT ["/bin/sh", "-c", "dbus-daemon --system --fork && exec /systemd1-shim \"$@\"", "sh"]
