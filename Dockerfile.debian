# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /out/systemd1-shim .

# Bundles its own dbus-daemon so this runs standalone - no separate dbus
# sidecar/emptyDir needed. dbus-system.conf listens at the same path
# real system.conf does, so dbus.ConnectSystemBus() finds it via its own
# default - no env var bridging or wrapper script required. But that
# socket still lives in this container's own /run, invisible to sibling
# containers - so this only works if nothing else in the pod (e.g. no
# real systemctl in another container) needs to reach the same bus. For
# the actual sidecar setup, use Dockerfile.scratch plus a shared
# dbus-daemon instead (see hooks/k8s_restarter.md).
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends dbus \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=build /out/systemd1-shim /systemd1-shim
ENTRYPOINT ["dbus-run-session", "--config-file=/etc/dbus-1/shim-system.conf", "--", "/systemd1-shim"]
